# ============================================================
# KitStash — Environment Variables
# Copy this file to .env.local and fill in the values
# ============================================================

# --- Supabase ---
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key-here

# --- Modal.com AI Pipeline ---
# Found after running: modal deploy ai_pipeline.py
# The URL printed in the terminal after deployment, e.g.:
# https://YOUR_USERNAME--kitstash-ai-pipeline-geardetector-process-media-endpoint.modal.run
MODAL_WEBHOOK_URL=https://YOUR_MODAL_ENDPOINT_URL
